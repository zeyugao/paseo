require "fileutils"
require "shellwords"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "me.elsanna.overkite"

# Store screenshots are rendered into assets/store-screenshots/output; see the
# README there. Google Play and F-Droid both read fastlane/metadata/android at
# the repo root, whose screenshot files link to those renders.
REPO_ROOT = File.expand_path("../../..", __dir__)
ANDROID_METADATA = File.join(REPO_ROOT, "fastlane/metadata/android")

# Google Play only has en-US screenshots, and some F-Droid locales in
# ANDROID_METADATA are not Play languages (Play rejects "ja"). supply uploads
# every locale folder in one edit, so give it only the en-US images.
def stage_google_play_screenshots
  root = Dir.mktmpdir("google-play-screenshots")
  images = File.join(ANDROID_METADATA, "en-US/images")
  %w[phoneScreenshots tenInchScreenshots].each do |kind|
    target = File.join(root, "en-US/images", kind)
    FileUtils.mkdir_p(target)
    Dir.glob(File.join(images, kind, "*.png")).sort.each do |file|
      FileUtils.cp(File.realpath(file), File.join(target, File.basename(file)))
    end
  end
  root
end

platform :ios do
  desc "Build and distribute to external TestFlight testers with Beta App Review"
  lane :build_testflight do
    team_id = ENV.fetch("IOS_TEAM_ID")
    profile_name = ENV.fetch("IOS_PROVISION_PROFILE_NAME")
    keychain_path = ENV.fetch("IOS_KEYCHAIN_PATH")
    output_directory = ENV.fetch("IOS_OUTPUT_DIRECTORY")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_P8"),
    )

    # Expo prebuild defaults push entitlements to development.
    update_plist(
      plist_path: "ios/Overkite/Overkite.entitlements",
      block: proc { |plist| plist["aps-environment"] = "production" },
    )

    # Keep the app's distribution profile off Pods and their resource bundles.
    update_code_signing_settings(
      path: "ios/Overkite.xcodeproj",
      targets: ["Overkite"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    ipa = build_app(
      workspace: "ios/Overkite.xcworkspace",
      scheme: "Overkite",
      configuration: "Release",
      destination: "generic/platform=iOS",
      # Gym's supported name for an App Store Connect / TestFlight export.
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: team_id,
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        manageAppVersionAndBuildNumber: false,
      },
      xcargs: { OTHER_CODE_SIGN_FLAGS: "--keychain #{keychain_path.shellescape}" },
      output_directory: output_directory,
      output_name: "Overkite.ipa",
      archive_path: File.join(output_directory, "Overkite.xcarchive"),
      buildlog_path: File.join(output_directory, "logs"),
      include_symbols: true,
    )


    # This submits only Beta App Review, never production App Store review.
    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: ipa,
      app_version: ENV.fetch("APP_VERSION"),
      build_number: ENV.fetch("APP_BUILD_VERSION"),
      distribute_external: true,
      groups: ["Overkite Beta"],
      submit_beta_review: true,
      notify_external_testers: true,
      skip_submission: false,
      skip_waiting_for_build_processing: false,
    )
  end
end

platform :android do
  desc "Replace the Google Play store screenshots with the ones in the repo"
  lane :upload_screenshots do
    # supply attaches listing changes to a release on the production track.
    # The release workflow passes the version code it just submitted; without
    # it, supply uses the track's only release.
    version_code = ENV["ANDROID_VERSION_CODE"].to_s.strip
    supply(
      package_name: APP_IDENTIFIER,
      json_key: ENV.fetch("GOOGLE_PLAY_JSON_KEY"),
      metadata_path: stage_google_play_screenshots,
      version_code: version_code.empty? ? nil : version_code.to_i,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      sync_image_upload: true,
    )
  end
end
