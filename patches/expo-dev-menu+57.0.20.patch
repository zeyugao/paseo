+private final class DevMenuFABHostingController: UIHostingController<DevMenuFABView> {
+  private var statusBarSource: UIViewController? {
+    // This passthrough window must not override the app's status-bar policy.
+    guard let window = viewIfLoaded?.window,
+      let keyWindow = window.windowScene?.keyWindow,
+      keyWindow !== window,
+      let root = keyWindow.rootViewController,
+      root !== self else {
+      return nil
+    }
+    var source = root
+    while let presented = source.presentedViewController, !presented.isBeingDismissed {
+      source = presented
+    }
+    return source
+  }
+
+  override var prefersStatusBarHidden: Bool {
+    statusBarSource?.prefersStatusBarHidden ?? super.prefersStatusBarHidden
+  }
+
+  override var preferredStatusBarUpdateAnimation: UIStatusBarAnimation {
+    statusBarSource?.preferredStatusBarUpdateAnimation ?? super.preferredStatusBarUpdateAnimation
+  }
+
